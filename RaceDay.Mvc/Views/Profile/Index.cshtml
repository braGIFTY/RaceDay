@model ProfileViewModel
@{
    ViewData["Title"] = "My profile";
    ViewData["Subtitle"] = "Your details and your picture.";
    var initial = string.IsNullOrWhiteSpace(Model.FullName) ? "?" : Model.FullName.Trim().Substring(0, 1).ToUpperInvariant();
}

<div class="row g-4">
    <div class="col-lg-4">
        <div class="rd-card p-4 text-center">
            @if (!string.IsNullOrEmpty(Model.ProfileImageUrl))
            {
                <img src="@Model.ProfileImageUrl" alt="Your profile picture" class="rounded-circle mb-3"
                     style="width:140px;height:140px;object-fit:cover;border:4px solid var(--rd-blue)" />
            }
            else
            {
                <span class="rd-avatar mb-3" aria-hidden="true" style="width:140px;height:140px;font-size:3.5rem;margin-right:0">@initial</span>
            }

            <h3>@Model.FullName</h3>
            <p class="rd-muted">@Model.Role</p>

            <form asp-action="UploadPicture" method="post" enctype="multipart/form-data" class="text-start mt-3">
                <label for="file" class="form-label">Change picture</label>
                <input id="file" name="file" type="file" class="form-control mb-2" accept="image/jpeg,image/png,image/webp" required />
                <div class="form-text mb-3">JPEG, PNG or WebP, up to 5 MB.</div>
                <button type="submit" class="btn btn-secondary btn-sm">Upload picture</button>
            </form>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="rd-card p-4">
            <h3>Your details</h3>
            <form asp-action="Update" method="post" novalidate class="mt-3">
                <partial name="_FormErrors" />
                <input type="hidden" asp-for="ProfileImageUrl" />
                <input type="hidden" asp-for="Role" />

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName" class="form-control" autocomplete="name" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Phone" class="form-label"></label>
                    <input asp-for="Phone" class="form-control" autocomplete="tel" />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">Save changes</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
