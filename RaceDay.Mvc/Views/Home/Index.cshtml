@model List<EventDto>
@{
    ViewData["Title"] = "RaceDay";
}

<h1>RaceDay</h1>
<p>Connection check: the events below are read from the API.</p>

@if (ViewBag.ApiError != null)
{
    <div class="alert alert-warning">@ViewBag.ApiError</div>
}
else if (!Model.Any())
{
    <p>The API replied, but there are no upcoming events yet.</p>
}
else
{
    <ul>
        @foreach (var ev in Model)
        {
            <li>@ev.Name, @ev.Location, @ev.EventDate.ToString("d MMM yyyy")</li>
        }
    </ul>
}
