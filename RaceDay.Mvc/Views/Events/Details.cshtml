@model EventDetailsViewModel
@{
    var ev = Model.Event;
    ViewData["Title"] = ev.Name;
    ViewData["Subtitle"] = ev.EventDate.ToString("dddd, dd MMMM yyyy") + " · " + ev.Location;
    var emoji = ev.EventType switch
    {
        "Run" => "🏃",
        "Walk" => "🚶",
        "Cycle" => "🚴",
        _ => "🏁"
    };
}

<div class="row g-4">
    <div class="col-lg-7">
        <div class="rd-card">
            <div class="rd-event-media" style="height:280px">
                @if (!string.IsNullOrEmpty(ev.BannerImageUrl))
                {
                    <img src="@ev.BannerImageUrl" alt="Banner for @ev.Name" />
                }
                else
                {
                    <span class="rd-event-emoji" style="font-size:5rem" aria-hidden="true">@emoji</span>
                }
                <span class="rd-badge-type">@ev.EventType</span>
            </div>
            <div class="p-4">
                <div class="row text-center g-3 mb-3">
                    <div class="col-4">
                        <div class="rd-stat-value" style="font-size:2.2rem">@ev.DistanceKm.ToString("0.##")</div>
                        <div class="rd-stat-label">Kilometres</div>
                    </div>
                    <div class="col-4">
                        <div class="rd-stat-value" style="font-size:2.2rem">@ev.EventDate.ToString("dd MMM").ToUpper()</div>
                        <div class="rd-stat-label">@ev.EventDate.ToString("yyyy")</div>
                    </div>
                    <div class="col-4">
                        <div class="rd-stat-value" style="font-size:2.2rem">@Model.Categories.Count</div>
                        <div class="rd-stat-label">Categories</div>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(ev.Description))
                {
                    <p class="mb-0">@ev.Description</p>
                }
                else
                {
                    <p class="rd-muted mb-0">The organiser hasn't added a description yet.</p>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="rd-card p-4">
            <h3>Enter this event</h3>

            @if (!Model.IsParticipant)
            {
                <p class="rd-muted mt-3 mb-0">You're signed in as an organiser, so you can look but not enter. <a href="~/ManageEvents">Manage your events</a></p>
            }
            else if (Model.IsPast)
            {
                <p class="rd-muted mt-3 mb-0">This event has already taken place.</p>
            }
            else if (Model.MyEnrolment != null && Model.MyEnrolment.Status == "Confirmed")
            {
                <div class="alert alert-success mt-3" role="alert">
                    You're entered in <strong>@Model.MyEnrolment.CategoryName</strong>
                    <span class="rd-status rd-status-confirmed ms-1">Confirmed</span>
                </div>
                <a href="~/MyEvents">View my events</a>
            }
            else if (!Model.Categories.Any())
            {
                <p class="rd-muted mt-3 mb-0">The organiser hasn't added any categories yet, so entries aren't open. Check back soon.</p>
            }
            else
            {
                if (Model.MyEnrolment != null)
                {
                    <p class="rd-muted mt-3 mb-0">You cancelled your earlier entry. You can enter again below.</p>
                }

                <form asp-action="Enrol" method="post" class="mt-3">
                    <input type="hidden" name="eventId" value="@ev.Id" />
                    <label for="categoryId" class="form-label">Choose your category</label>
                    <select id="categoryId" name="categoryId" class="form-select mb-3" required>
                        <option value="">Select a category</option>
                        @foreach (var c in Model.Categories)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </select>
                    <button type="submit" class="btn btn-primary w-100">Enter this event</button>
                </form>
            }
        </div>

        @if (Model.Categories.Any())
        {
            <div class="rd-card p-4 mt-4">
                <h3>Categories</h3>
                <ul class="list-unstyled mt-3 mb-0">
                    @foreach (var c in Model.Categories)
                    {
                        <li class="mb-2"><strong>@c.Name</strong>@if (!string.IsNullOrWhiteSpace(c.Description)) { <span class="rd-muted"> &mdash; @c.Description</span> }</li>
                    }
                </ul>
            </div>
        }
    </div>
</div>
