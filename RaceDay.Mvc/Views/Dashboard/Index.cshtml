@model DashboardViewModel
@{
    ViewData["Title"] = "Organiser dashboard";
    ViewData["Subtitle"] = "Your events, who has entered, and what's coming up.";
}

@if (Model.Error != null)
{
    <div class="alert alert-warning" role="alert">@Model.Error</div>
}

<div class="row g-4 mb-4">
    <div class="col-6 col-lg-3">
        <div class="rd-card rd-stat">
            <div class="rd-stat-value">@Model.Events.Count</div>
            <div class="rd-stat-label">Events created</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="rd-card rd-stat">
            <div class="rd-stat-value">@Model.UpcomingCount</div>
            <div class="rd-stat-label">Upcoming events</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="rd-card rd-stat">
            <div class="rd-stat-value">@Model.TotalEnrolments</div>
            <div class="rd-stat-label">Total enrolments</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="rd-card rd-stat">
            <div class="rd-stat-value">@(Model.NextEventDate?.ToString("dd MMM").ToUpper() ?? "NONE")</div>
            <div class="rd-stat-label">Next event</div>
        </div>
    </div>
</div>

<div class="d-flex flex-wrap gap-2 mb-4">
    <a class="btn btn-primary" href="~/ManageEvents/Create">Create an event</a>
    <a class="btn btn-secondary" href="~/Results">Record results</a>
</div>

<div class="rd-section-head">
    <h2>Your events</h2>
    <span class="rd-stripes" aria-hidden="true"><i></i><i></i><i></i></span>
</div>

@if (!Model.Events.Any())
{
    <div class="rd-empty rd-card">
        <div class="rd-empty-icon" aria-hidden="true">🏁</div>
        <h3>No events yet</h3>
        <p>Create your first event and people can start entering.</p>
        <a class="btn btn-primary" href="~/ManageEvents/Create">Create an event</a>
    </div>
}
else
{
    <div class="rd-card">
        <div class="table-responsive">
            <table class="table rd-table align-middle">
                <thead>
                    <tr><th>Event</th><th>Date</th><th>Where</th><th>Enrolments</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var ev in Model.Events)
                    {
                        <tr>
                            <td><strong>@ev.Name</strong><div class="rd-muted small">@ev.EventType &middot; @ev.DistanceKm.ToString("0.##") km</div></td>
                            <td>@ev.EventDate.ToString("dd MMM yyyy")</td>
                            <td>@ev.Location</td>
                            <td>@ev.EnrolmentCount</td>
                            <td class="text-end">
                                <a class="btn btn-outline-secondary btn-sm" href="@Url.Content("~/Enrolments?eventId=" + ev.Id)">Enrolments</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
