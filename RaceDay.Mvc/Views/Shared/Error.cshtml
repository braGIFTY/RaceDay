@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="rd-empty">
    <div class="rd-empty-icon" aria-hidden="true">🏁</div>
    <h2>That one didn't go to plan</h2>
    <p>Something went wrong on our side. Please try again in a moment, or head back to the start line.</p>
    <a class="btn btn-primary" href="~/">Back to the start line</a>
</div>

@if (Model?.ShowRequestId ?? false)
{
    <p class="text-center rd-muted small">Reference: <code>@Model.RequestId</code></p>
}
